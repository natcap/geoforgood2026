# ==== Copy to .env and fill in. .env is git-ignored. ====

# GCP project that has BOTH Vertex AI API enabled AND Earth Engine registered.
GCP_PROJECT_ID=your-gcp-project-id

# Vertex region for Gemini (Earth Engine itself is global).
VERTEX_LOCATION=us-central1

# ---- Credentials: pick ONE of the two options below. ----
#
# Option A - service-account key. Set both lines. The key authorizes BOTH
# Earth Engine and Vertex; relative paths resolve from the repo root.
#
# Option B - Application Default Credentials. Leave BOTH lines blank and run
# once, in a terminal:
#     gcloud auth application-default login --project your-gcp-project-id
# On a GCE VM / Cloud Run / Colab there is nothing to run: the attached
# service account is already the ADC.

# The service account email used for Earth Engine (must be EE-registered).
EE_SERVICE_ACCOUNT=natcap-agent@your-gcp-project-id.iam.gserviceaccount.com

# Path to the service-account JSON key.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/sa-key.json

# Gemini models (bare ids; the provider prefix is added automatically).
# Orchestrator does the planning; workers do the high-volume grunt work.
ORCHESTRATOR_MODEL=gemini-2.5-pro
WORKER_MODEL=gemini-2.5-flash

# Which backend runs the models:
#   vertex  -> Vertex AI (API key = Express mode, else service account/ADC).
#   gemini  -> Gemini Developer API via an API key (set a key below).
# Earth Engine ignores this setting: it always uses the credential above.
LLM_BACKEND=vertex

# An API key for the models. Setting either of these routes the models via an
# API-key path (no service account needed for the models).
VERTEX_API_KEY=
GEMINI_API_KEY=
